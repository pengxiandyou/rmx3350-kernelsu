# ============================================================
# RMX3350 (真我GT Neo 闪速版) / MT6893 / Linux 4.19.191 / Android 13 F.28
# 最小侵入式 overlay —— 只做两件事，绝不触碰任何 ABI 相关选项
#
# 1) 把 KernelSU 以 built-in 方式编进内核（唯一可行模式：
#    非 GKI 无官方镜像，MODULE_SIG_FORCE 又让 LKM 走不通）
# 2) 关掉 MODULE_SIG_FORCE —— 否则我们自己编出来的内核用的是新生成的
#    certs/signing_key.pem，vendor 分区里原厂私钥签名的 .ko 会被全部拒绝加载
#
# 明确不动的东西（动了就会让 vendor .ko 的 __crc_ 对不上，直接黑屏）：
#   CONFIG_HZ       保持 250
#   CONFIG_MODVERSIONS 保持 y
#   CONFIG_KALLSYMS_ALL 保持 not set
#   CONFIG_DEVTMPFS / CONFIG_F2FS_FS_COMPRESSION / 调度器 / 网络栈 …
# ============================================================

# --- KernelSU (in-tree, built-in) ---
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y

# --- 允许加载原厂签名的 vendor 模块 ---
CONFIG_MODULE_SIG=y
# CONFIG_MODULE_SIG_FORCE is not set
